# copy to .env and fill in, or just export these in your shell
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_WORKSPACE_ID=              # only needed for identity-linked keys (see REPRODUCE.md)
TRIAGE_PROVIDER=anthropic      # anthropic | mock
TRIAGE_MODEL=claude-sonnet-5   # any model your key can reach
TRIAGE_PRICE_IN=3.00           # USD per million input tokens, for cost accounting
TRIAGE_PRICE_OUT=15.00         # USD per million output tokens
